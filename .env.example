# ====================================================================
# GigSaathi - Environment Variables (.env.example)
# ====================================================================

# 1. Application URL (Production or Local)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# 2. Google Gemini API (Optional: The application includes an offline mock engine)
# Get your API key from https://aistudio.google.com/
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here

# 3. OpenAI API Configuration (Optional)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# 4. Supabase Configuration (Optional: for cloud auth/persistence)
# Get these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
